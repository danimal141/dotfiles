{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "python3 ~/.codex/hooks/block-destructive-commands.py",
            "statusMessage": "Checking command safety...",
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash ~/.codex/herdr-agent-state.sh session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "python3 ~/.codex/hooks/session-namer.py",
            "timeout": 10,
            "type": "command"
          },
          {
            "async": true,
            "command": "python3 ~/.codex/hooks/notify.py",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "python3 ~/.codex/hooks/posttooluse-japanese-lint.py",
            "statusMessage": "Linting Japanese prose...",
            "timeout": 30,
            "type": "command"
          },
          {
            "command": "python3 ~/.codex/hooks/posttooluse-textlint-ai-words.py",
            "statusMessage": "Checking AI words (textlint)...",
            "timeout": 40,
            "type": "command"
          }
        ],
        "matcher": "^apply_patch$"
      }
    ]
  }
}
